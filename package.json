{
  "name": "todo-app",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "cd packages/db && bunx prisma generate && cd ../..",
    "db:seed": "cd packages/db && bunx prisma db seed && cd ../..",
    "start:web": "cd apps/web && bun run start",
    "start:ws": "cd apps/ws-server && bun run dev",
    "start:https": "cd apps/https && bun run dev"
  },
  "devDependencies": {
    "@prisma/client": "^6.6.0",
    "prettier": "^3.7.4",
    "prisma": "^6.6.0",
    "puppeteer-core": "^25.16.0",
    "turbo": "^2.9.6",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/ws": "^8.18.1",
    "@viz-js/viz": "^3.31.0",
    "ws": "^8.20.0"
  }
}
